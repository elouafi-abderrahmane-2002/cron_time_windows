<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cron_tw_wizard_view_form" model="ir.ui.view">
        <field name="name">cron.tw.wizard.view.form</field>
        <field name="model">cron.tw.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Time Windows">
                <group>
                    <group>
                        <field name="cron_ids" widget="many2many_tags"/>
                        <field name="source" widget="radio"/>
                        <field name="template_id"
                               invisible="source != 'template'" required="source == 'template'"/>
                        <field name="reference_cron_id"
                               invisible="source != 'cron'" required="source == 'cron'"/>
                    </group>
                    <group>
                        <field name="tw_mode" widget="radio"/>
                        <field name="tw_tz" invisible="tw_mode == 'native'"/>
                        <field name="tw_outside_action" widget="radio"
                               invisible="tw_mode != 'windows'"/>
                    </group>
                </group>
                <div class="alert alert-info" role="status" invisible="tw_mode != 'native'">The selected scheduled actions go back to Odoo's standard scheduling. Their time windows and fixed times are kept.</div>
                <div class="alert alert-warning" role="status" invisible="tw_mode == 'native'">The time windows or fixed times of the selected scheduled actions are replaced by the ones below.</div>
                <field name="tw_window_ids" invisible="tw_mode != 'windows'">
                    <tree editable="bottom"
                          decoration-muted="action == 'pause'"
                          decoration-warning="interval_exceeds_window">
                        <field name="sequence" widget="handle"/>
                        <field name="hour_from" widget="float_time"/>
                        <field name="hour_to" widget="float_time"/>
                        <field name="action"/>
                        <field name="interval_number"
                               invisible="action != 'run'" required="action == 'run'"/>
                        <field name="interval_type"
                               invisible="action != 'run'" required="action == 'run'"/>
                        <field name="monday"/>
                        <field name="tuesday"/>
                        <field name="wednesday"/>
                        <field name="thursday"/>
                        <field name="friday"/>
                        <field name="saturday"/>
                        <field name="sunday"/>
                        <field name="interval_exceeds_window" column_invisible="True"/>
                    </tree>
                </field>
                <field name="tw_fixed_ids" invisible="tw_mode != 'fixed'">
                    <tree editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="frequency"/>
                        <field name="time_of_day" widget="float_time"/>
                        <field name="weekday"
                               invisible="frequency != 'weekly'" required="frequency == 'weekly'"/>
                        <field name="day_of_month"
                               invisible="frequency != 'monthly'" required="frequency == 'monthly'"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Apply"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cron_tw_wizard" model="ir.actions.act_window">
        <field name="name">Apply Time Windows</field>
        <field name="res_model">cron.tw.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_ir_cron"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
