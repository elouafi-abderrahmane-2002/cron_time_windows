#: model:ir.model.fields,help:cron_time_windows.field_ir_cron__tw_outside_action
msgid "What happens at times that no window covers: the job does not run, or it runs at the scheduled action's own interval (Execute Every), counted from the end of the previous window."
msgstr "Ce qui se passe aux heures qu'aucune plage ne couvre : la tâche ne s'exécute pas, ou elle s'exécute à l'intervalle propre de l'action planifiée (Exécuter tous les), compté depuis la fin de la plage précédente."

#. module: cron_time_windows
#. odoo-python
#: code:addons/cron_time_windows/models/cron_tw_mixin.py:0
msgid "Window %(window)s: a running window needs an interval greater than zero."
msgstr "Plage %(window)s : une plage d'exécution doit avoir un intervalle supérieur à zéro."

#. module: cron_time_windows
#. odoo-python
#: code:addons/cron_time_windows/models/cron_tw_mixin.py:0
msgid "Window %(window)s: start and end must lie between 00:00 and 23:59 (write midnight as 00:00)."
msgstr "Plage %(window)s : le début et la fin doivent être compris entre 00:00 et 23:59 (écrivez minuit 00:00)."

#. module: cron_time_windows
#. odoo-python
#: code:addons/cron_time_windows/models/cron_tw_mixin.py:0
msgid "Window %(window)s: the interval is longer than the window, so the job runs only once, at %(start)s."
msgstr "Plage %(window)s : l'intervalle est plus long que la plage, la tâche ne s'exécute donc qu'une fois, à %(start)s."

#. module: cron_time_windows
#. odoo-python
#: code:addons/cron_time_windows/models/cron_tw_mixin.py:0
msgid "Windows %(first)s and %(second)s overlap on %(day)s."
msgstr "Les plages %(first)s et %(second)s se chevauchent le %(day)s."

#. module: cron_time_windows
#. odoo-python
#: code:addons/cron_time_windows/models/ir_cron.py:0
msgid "With this schedule the job would never run."
msgstr "Avec cette planification, la tâche ne s'exécuterait jamais."

